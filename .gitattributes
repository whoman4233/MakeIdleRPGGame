# 줄바꿈 정규화 (CRLF 혼재 방지)
* text=auto eol=lf

# 소스/텍스트
*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.cginc     text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf

# Unity YAML (텍스트, 머지 도구 사용)
*.unity     merge=unityyamlmerge eol=lf
*.prefab    merge=unityyamlmerge eol=lf
*.asset     merge=unityyamlmerge eol=lf
*.mat       merge=unityyamlmerge eol=lf
*.meta      text eol=lf

# 바이너리 (정규화 제외)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.fbx  binary
*.ttf  binary
*.otf  binary
*.dll  binary
